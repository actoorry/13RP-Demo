<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!-- 人员（sys_person）Mapper：登录认证 + 员工管理（由 PersonMapper.java 注解迁移至 XML，行为完全一致） -->
<mapper namespace="com.boyu.demo.module.org.mapper.PersonMapper">

    <!-- 按登录账号查人员（未逻辑删除）。
         列自动映射依赖 mybatis-plus map-underscore-to-camel-case=true，
         institution_id → institutionId、create_time → createTime。 -->
    <select id="selectByAccount" resultType="com.boyu.demo.module.org.entity.SysPerson">
        SELECT *
        FROM sys_person
        WHERE account = #{account}
          AND deleted = 0
    </select>

</mapper>
